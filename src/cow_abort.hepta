hia-asm.v1 hepta.hia.program.v8 selfhost_elf
fn cow_abort(destination:mutbuf,state:mutbuf) -> (u32) effects(read,write,trap) entry(start)
block start(destination:mutbuf,state:mutbuf)
  ca_dl:usize = buffer.len(destination)
  ca_page:usize = const() {"value":4096}
  ca_dest_ok:bool = compare.eq(ca_dl,ca_page)
  branch ca_dest_ok state_shape(destination,state) bad_dest()
block bad_dest()
  ca_ed:u32 = const() {"value":1}
  ret(ca_ed)
block state_shape(ca_dst:mutbuf,ca_st:mutbuf)
  ca_sl:usize = buffer.len(ca_st)
  ca_page_s:usize = const() {"value":4096}
  ca_state_ok:bool = compare.eq(ca_sl,ca_page_s)
  branch ca_state_ok decode(ca_dst,ca_st) bad_state()
block bad_state()
  ca_es:u32 = const() {"value":2}
  ret(ca_es)
block decode(ca_dd:mutbuf,ca_ss:mutbuf)
  ca_o0:usize = const() {"value":0}
  ca_o1:usize = const() {"value":1}
  ca_o2:usize = const() {"value":2}
  ca_o3:usize = const() {"value":3}
  ca_o4:usize = const() {"value":4}
  ca_o5:usize = const() {"value":5}
  ca_b0:u8 = buffer.load(ca_ss,ca_o0)
  ca_b1:u8 = buffer.load(ca_ss,ca_o1)
  ca_b2:u8 = buffer.load(ca_ss,ca_o2)
  ca_b3:u8 = buffer.load(ca_ss,ca_o3)
  ca_expected_src:u8 = buffer.load(ca_ss,ca_o4)
  ca_expected_dst:u8 = buffer.load(ca_ss,ca_o5)
  ca_w0:u64 = int.cast(ca_b0) {"mode":"wrap"}
  ca_w1:u64 = int.cast(ca_b1) {"mode":"wrap"}
  ca_w2:u64 = int.cast(ca_b2) {"mode":"wrap"}
  ca_w3:u64 = int.cast(ca_b3) {"mode":"wrap"}
  ca_eight:u64 = const() {"value":8}
  ca_hi_src:u64 = int.shl.checked(ca_w1,ca_eight)
  ca_hi_dst:u64 = int.shl.checked(ca_w3,ca_eight)
  ca_src:u64 = bit.or(ca_hi_src,ca_w0)
  ca_dst_decode:u64 = bit.or(ca_hi_dst,ca_w2)
  ca_first:u64 = const() {"value":6}
  jump scan_reserved(ca_dd,ca_ss,ca_src,ca_dst_decode,ca_expected_src,ca_expected_dst,ca_first)
block scan_reserved(ca_rd:mutbuf,ca_rs:mutbuf,ca_rsrc:u64,ca_rdst:u64,ca_re:u8,ca_rf:u8,ca_ri:u64)
  ca_res_end:u64 = const() {"value":16}
  ca_more:bool = compare.lt(ca_ri,ca_res_end)
  branch ca_more check_reserved(ca_rd,ca_rs,ca_rsrc,ca_rdst,ca_re,ca_rf,ca_ri) check_slots(ca_rd,ca_rs,ca_rsrc,ca_rdst,ca_re,ca_rf)
block check_reserved(ca_cd:mutbuf,ca_cs:mutbuf,ca_ci:u64,ca_cj:u64,ca_ce:u8,ca_cf:u8,ca_ck:u64)
  ca_at:usize = int.cast(ca_ck) {"mode":"wrap"}
  ca_byte:u8 = buffer.load(ca_cs,ca_at)
  ca_zero:u8 = const() {"value":0}
  ca_ok:bool = compare.eq(ca_byte,ca_zero)
  branch ca_ok advance(ca_cd,ca_cs,ca_ci,ca_cj,ca_ce,ca_cf,ca_ck) bad_reserved()
block advance(ca_ad:mutbuf,ca_as:mutbuf,ca_ai:u64,ca_aj:u64,ca_ae:u8,ca_af:u8,ca_ak:u64)
  ca_one:u64 = const() {"value":1}
  ca_next:u64 = int.add.wrap(ca_ak,ca_one)
  jump scan_reserved(ca_ad,ca_as,ca_ai,ca_aj,ca_ae,ca_af,ca_next)
block bad_reserved()
  ca_er:u32 = const() {"value":3}
  ret(ca_er)
block check_slots(ca_xd:mutbuf,ca_xs:mutbuf,ca_xi:u64,ca_xj:u64,ca_xe:u8,ca_xf:u8)
  ca_limit:u64 = const() {"value":4080}
  ca_i_ok:bool = compare.lt(ca_xi,ca_limit)
  ca_j_ok:bool = compare.lt(ca_xj,ca_limit)
  ca_distinct:bool = compare.ne(ca_xi,ca_xj)
  ca_both:bool = bool.and(ca_i_ok,ca_j_ok)
  ca_good:bool = bool.and(ca_both,ca_distinct)
  branch ca_good check_count(ca_xd,ca_xs,ca_xi,ca_xj,ca_xe,ca_xf) bad_slots()
block bad_slots()
  ca_et:u32 = const() {"value":4}
  ret(ca_et)
block check_count(ca_sd:mutbuf,ca_ss_check_count:mutbuf,ca_si:u64,ca_sj:u64,ca_se:u8,ca_sf:u8)
  ca_base:u64 = const() {"value":16}
  ca_srcidx:u64 = int.add.wrap(ca_si,ca_base)
  ca_dstidx:u64 = int.add.wrap(ca_sj,ca_base)
  ca_srcpos:usize = int.cast(ca_srcidx) {"mode":"wrap"}
  ca_dstpos:usize = int.cast(ca_dstidx) {"mode":"wrap"}
  ca_seen_src:u8 = buffer.load(ca_ss_check_count,ca_srcpos)
  ca_seen_dst:u8 = buffer.load(ca_ss_check_count,ca_dstpos)
  ca_match_src:bool = compare.eq(ca_seen_src,ca_se)
  ca_match_dst:bool = compare.eq(ca_seen_dst,ca_sf)
  ca_stable:bool = bool.and(ca_match_src,ca_match_dst)
  branch ca_stable check_ownership(ca_sd,ca_ss_check_count,ca_srcpos,ca_dstpos,ca_se,ca_sf) bad_stale()
block bad_stale()
  ca_ec:u32 = const() {"value":5}
  ret(ca_ec)
block check_ownership(ca_od:mutbuf,ca_os:mutbuf,ca_op:usize,ca_oq:usize,ca_oe:u8,ca_of:u8)
  ca_zero_check_ownership:u8 = const() {"value":0}
  ca_one_check_ownership:u8 = const() {"value":1}
  ca_max:u8 = const() {"value":254}
  ca_positive:bool = compare.ge(ca_oe,ca_one_check_ownership)
  ca_notmax:bool = compare.le(ca_oe,ca_max)
  ca_private:bool = compare.eq(ca_of,ca_one_check_ownership)
  ca_bounded:bool = bool.and(ca_positive,ca_notmax)
  ca_authorized:bool = bool.and(ca_bounded,ca_private)
  branch ca_authorized clear_page(ca_od,ca_os,ca_op,ca_oq,ca_oe,ca_zero_check_ownership) bad_ownership()
block bad_ownership()
  ca_eo:u32 = const() {"value":6}
  ret(ca_eo)
block clear_page(ca_pd:mutbuf,ca_ps:mutbuf,ca_pi:usize,ca_pj:usize,ca_pe:u8,ca_pz:u8)
  ca_page_begin:usize = const() {"value":0}
  ca_page_bytes:usize = const() {"value":4096}
  _ = buffer.fill_range(ca_pd,ca_page_begin,ca_page_bytes,ca_pz)
  ca_restore_one:u8 = const() {"value":1}
  ca_restored:u8 = int.add.wrap(ca_pe,ca_restore_one)
  _ = buffer.store(ca_ps,ca_pi,ca_restored)
  _ = buffer.store(ca_ps,ca_pj,ca_pz)
  ca_success:u32 = const() {"value":0}
  ret(ca_success)
end
