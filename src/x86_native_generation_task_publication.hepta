  outside2:bool = bool.or(d4,d5)
  outside3:bool = bool.and(outside0,outside1)
  outside:bool = bool.and(outside3,outside2)
  e0:bool = bool.and(a0,a1)
  e1:bool = bool.and(a2,a3)
  e2:bool = bool.and(b0,b1)
  e3:bool = bool.and(b2,b3)
  e4:bool = bool.and(c0,c1)
  e5:bool = bool.and(c2,valid_old)
  e6:bool = bool.and(e0,e1)
