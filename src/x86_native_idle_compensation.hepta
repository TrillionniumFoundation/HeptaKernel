  branch valid decode(slot,before,count,current,selected) invalid()
block decode(ptr:u64,old:u64,n:u64,cur:u64,sel:u64)
  lowmask:u64 = const() {"value":4294967295}
  shift:u64 = const() {"value":32}
  maxbase:u64 = const() {"value":4294967293}
  bits:u64 = bit.and(old,lowmask)
