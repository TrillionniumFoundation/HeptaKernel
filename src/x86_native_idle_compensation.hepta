  room:bool = compare.le(gen,maxbase)
  branch room check(ptr,n,cur,sel,bits,gen) invalid()
block check(addr:u64,num:u64,cursor:u64,target:u64,mask:u64,g:u64)
  curone:u64 = const() {"value":1}
  marker:u64 = int.shl.checked(curone,cursor)
  curbit:u64 = bit.and(mask,marker)
  z:u64 = const() {"value":0}
  absent:bool = compare.eq(curbit,z)
  idleidx:u64 = int.sub.wrap(num,curone)
  upper:u64 = int.shr.checked(mask,idleidx)
  clean:bool = compare.eq(upper,z)
  both:bool = bool.and(absent,clean)
  branch both choose(addr,num,cursor,target,mask,g,idleidx) invalid()
block choose(caddr:u64,cnum:u64,ccur:u64,ctarget:u64,cmask:u64,cgen:u64,cidle:u64)
