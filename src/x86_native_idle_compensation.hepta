block enter(eaddr:u64,ecur:u64,etarget:u64,emask:u64,egen:u64,eidle:u64)
  targetidle:bool = compare.eq(etarget,eidle)
  realtask:bool = compare.ne(ecur,eidle)
  ok:bool = bool.and(targetidle,realtask)
  branch ok compensate(eaddr,emask,egen,emask) invalid()
block claim(daddr:u64,dtarget:u64,dmask:u64,dgen:u64,dpick:u64)
  matched:bool = compare.eq(dtarget,dpick)
  branch matched remove(daddr,dmask,dgen,dpick) invalid()
block remove(raddr:u64,rmask:u64,rgen:u64,rpick:u64)
  unit:u64 = const() {"value":1}
  bit:u64 = int.shl.checked(unit,rpick)
  removed:u64 = bit.xor(rmask,bit)
  jump compensate(raddr,rmask,rgen,removed)
block compensate(address:u64,bitmap:u64,generation:u64,afterbits:u64)
  onegen:u64 = const() {"value":1}
  twogen:u64 = const() {"value":2}
  sh:u64 = const() {"value":32}
  aftergen:u64 = int.add.wrap(generation,onegen)
  restoregen:u64 = int.add.wrap(generation,twogen)
  afterhigh:u64 = int.shl.checked(aftergen,sh)
  restorehigh:u64 = int.shl.checked(restoregen,sh)
  afterword:u64 = bit.or(afterhigh,afterbits)
  restored:u64 = bit.or(restorehigh,bitmap)
  seen:u64 = x86.atomic.cmpxchg64(address,afterword,restored)
  same:bool = compare.eq(seen,afterword)
