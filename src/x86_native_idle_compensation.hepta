block idle()
  idlecode:u64 = const() {"value":64}
  ret(idlecode)
block invalid()
  badcode:u64 = const() {"value":65}
  ret(badcode)
end
fn f0(slot:u64,before:u64,count:u64,current:u64,selected:u64) -> (u64) effects(privilege,atomic,read,write,trap) entry(start)
block start(slot:u64,before:u64,count:u64,current:u64,selected:u64)
  zero:u64 = const() {"value":0}
  one:u64 = const() {"value":1}
  seven:u64 = const() {"value":7}
  limit:u64 = const() {"value":140737488355328}
  width:u64 = const() {"value":32}
