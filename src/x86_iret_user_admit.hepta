hia-asm.v1 hepta.hia.program.v8 selfhost_elf
exports(iret_user_admit)
fn iret_user_admit(rip:u64,rsp:u64,rflags:u64,cs:u64,ss:u64) -> (u32) effects(trap) entry(start)
block start(rip:u64,rsp:u64,rflags:u64,cs:u64,ss:u64)
  minrip:u64 = const() {"value":4096}
  top:u64 = const() {"value":140737488355328}
  riplo:bool = compare.ge(rip,minrip)
  riphi:bool = compare.lt(rip,top)
  ripok:bool = bool.and(riplo,riphi)
  branch ripok stack(rip,rsp,rflags,cs,ss) bad_rip()
block bad_rip()
  code_rip:u32 = const() {"value":1}
  ret(code_rip)
block stack(srip:u64,srsp:u64,sflags:u64,scs:u64,sss:u64)
  minstack:u64 = const() {"value":8192}
  stop:u64 = const() {"value":140737488355328}
  alignmask:u64 = const() {"value":15}
  zero:u64 = const() {"value":0}
  stacklo:bool = compare.ge(srsp,minstack)
  stackhi:bool = compare.lt(srsp,stop)
  misalign:u64 = bit.and(srsp,alignmask)
  stackaligned:bool = compare.eq(misalign,zero)
  stackextent:bool = bool.and(stacklo,stackhi)
  stackok:bool = bool.and(stackextent,stackaligned)
  branch stackok selectors(srip,srsp,sflags,scs,sss) bad_stack()
block bad_stack()
  code_stack:u32 = const() {"value":2}
  ret(code_stack)
block selectors(arip:u64,arsp:u64,aflags:u64,acs:u64,ass:u64)
  cscode:u64 = const() {"value":51}
  sscode:u64 = const() {"value":59}
  codeok:bool = compare.eq(acs,cscode)
  dataok:bool = compare.eq(ass,sscode)
  bothok:bool = bool.and(codeok,dataok)
  branch bothok flags(arip,arsp,aflags) bad_selectors()
block bad_selectors()
  code_selectors:u32 = const() {"value":3}
  ret(code_selectors)
block flags(frip:u64,frsp:u64,fflags:u64)
  required:u64 = const() {"value":2}
  forbidden:u64 = const() {"value":18446744073709548840}
  no_bits:u64 = const() {"value":0}
  present:u64 = bit.and(fflags,required)
  extras:u64 = bit.and(fflags,forbidden)
  bitoneok:bool = compare.eq(present,required)
  extrasok:bool = compare.eq(extras,no_bits)
  flagok:bool = bool.and(bitoneok,extrasok)
  branch flagok disjoint(frip,frsp) bad_flags()
block bad_flags()
  code_flags:u32 = const() {"value":4}
  ret(code_flags)
block disjoint(drip:u64,drsp:u64)
  one:u64 = const() {"value":1}
  page_mask:u64 = const() {"value":18446744073709547520}
  page_size:u64 = const() {"value":4096}
  last_stack_byte:u64 = int.sub.wrap(drsp,one)
  stack_page_start:u64 = bit.and(last_stack_byte,page_mask)
  stack_page_end:u64 = int.add.wrap(stack_page_start,page_size)
  before:bool = compare.lt(drip,stack_page_start)
  after:bool = compare.ge(drip,stack_page_end)
  disjoint_ok:bool = bool.or(before,after)
  branch disjoint_ok accepted() bad_overlap()
block bad_overlap()
  code_overlap:u32 = const() {"value":5}
  ret(code_overlap)
block accepted()
  code_good:u32 = const() {"value":0}
  ret(code_good)
end
