hia-asm.v1 hepta.hia.program.v8 selfhost_elf
exports(shootdown_admit)
fn shootdown_admit(request:readbuf) -> (u32) effects(read,trap) entry(start)
block start(request:readbuf)
  length:usize = buffer.len(request)
  header:usize = const() {"value":48}
  enough:bool = compare.ge(length,header)
  branch enough decode(request,length) bad_wire()
block bad_wire()
  e1:u32 = const() {"value":1}
  ret(e1)
block decode(r1:readbuf,length1:usize)
  o0:usize = const() {"value":0}
  o8:usize = const() {"value":8}
  o16:usize = const() {"value":16}
  o24:usize = const() {"value":24}
  o32:usize = const() {"value":32}
  o40:usize = const() {"value":40}
  root1:u64 = call(r1,o0) {"function":"read_u64"}
  va1:u64 = call(r1,o8) {"function":"read_u64"}
  epoch1:u64 = call(r1,o16) {"function":"read_u64"}
  online1:u64 = call(r1,o24) {"function":"read_u64"}
  target1:u64 = call(r1,o32) {"function":"read_u64"}
  count1:u64 = call(r1,o40) {"function":"read_u64"}
  jump shape(r1,length1,root1,va1,epoch1,online1,target1,count1)
block shape(r2:readbuf,length2:usize,root2:u64,va2:u64,epoch2:u64,online2:u64,target2:u64,count2:u64)
  minimum:u64 = const() {"value":1}
  maximum:u64 = const() {"value":64}
  stride:u64 = const() {"value":32}
  head:u64 = const() {"value":48}
  cmin:bool = compare.ge(count2,minimum)
  cmax:bool = compare.le(count2,maximum)
  countok:bool = bool.and(cmin,cmax)
  bytes:u64 = int.mul.wrap(count2,stride)
  total:u64 = int.add.wrap(bytes,head)
  size:u64 = int.cast(length2) {"mode":"wrap"}
  exact:bool = compare.eq(total,size)
  wireok:bool = bool.and(countok,exact)
  branch wireok profile(r2,root2,va2,epoch2,online2,target2,count2) bad_wire()
block profile(r3:readbuf,root3:u64,va3:u64,epoch3:u64,online3:u64,target3:u64,count3:u64)
  zero:u64 = const() {"value":0}
  one:u64 = const() {"value":1}
  lowmask:u64 = const() {"value":4095}
  shift52:u64 = const() {"value":52}
  shift48:u64 = const() {"value":48}
  shift47:u64 = const() {"value":47}
  highall:u64 = const() {"value":65535}
  root_low:u64 = bit.and(root3,lowmask)
  root_high:u64 = int.shr.checked(root3,shift52)
  aligned:bool = compare.eq(root_low,zero)
  physical:bool = compare.eq(root_high,zero)
  nonzero:bool = compare.ne(root3,zero)
  ra:bool = bool.and(aligned,physical)
  rootok:bool = bool.and(ra,nonzero)
  va_low:u64 = bit.and(va3,lowmask)
  va_high:u64 = int.shr.checked(va3,shift48)
  va_sign_word:u64 = int.shr.checked(va3,shift47)
  va_sign:u64 = bit.and(va_sign_word,one)
  va_aligned:bool = compare.eq(va_low,zero)
  pos:bool = compare.eq(va_sign,zero)
  pos_high:bool = compare.eq(va_high,zero)
  neg:bool = compare.eq(va_sign,one)
  neg_high:bool = compare.eq(va_high,highall)
  posok:bool = bool.and(pos,pos_high)
  negok:bool = bool.and(neg,neg_high)
  canon:bool = bool.or(posok,negok)
  vaok:bool = bool.and(va_aligned,canon)
  epochok:bool = compare.ne(epoch3,zero)
  onlineok:bool = compare.ne(online3,zero)
  targetok:bool = compare.ne(target3,zero)
  outside_mask:u64 = bit.not(online3)
  outside:u64 = bit.and(target3,outside_mask)
  subset:bool = compare.eq(outside,zero)
  pa:bool = bool.and(rootok,vaok)
  pb:bool = bool.and(epochok,onlineok)
  pc:bool = bool.and(targetok,subset)
  pd:bool = bool.and(pa,pb)
  complete:bool = bool.and(pd,pc)
  branch complete scan_begin(r3,root3,epoch3,target3,count3) bad_profile()
block bad_profile()
  e2:u32 = const() {"value":2}
  ret(e2)
block scan_begin(r4:readbuf,root4:u64,epoch4:u64,target4:u64,count4:u64)
  zero4:u64 = const() {"value":0}
  jump scan(r4,root4,epoch4,target4,count4,zero4,zero4)
block scan(r5:readbuf,root5:u64,epoch5:u64,target5:u64,count5:u64,i5:u64,seen5:u64)
  more:bool = compare.lt(i5,count5)
  branch more row(r5,root5,epoch5,target5,count5,i5,seen5) complete_scan(seen5,target5)
block row(r6:readbuf,root6:u64,epoch6:u64,target6:u64,count6:u64,i6:u64,seen6:u64)
  stride6:u64 = const() {"value":32}
  header6:u64 = const() {"value":48}
  off8:u64 = const() {"value":8}
  off16:u64 = const() {"value":16}
  off24:u64 = const() {"value":24}
  a6:u64 = int.mul.wrap(i6,stride6)
  base6:u64 = int.add.wrap(a6,header6)
  b6:u64 = int.add.wrap(base6,off8)
  c6:u64 = int.add.wrap(base6,off16)
  d6:u64 = int.add.wrap(base6,off24)
  p6:usize = int.cast(base6) {"mode":"wrap"}
  q6:usize = int.cast(b6) {"mode":"wrap"}
  s6:usize = int.cast(c6) {"mode":"wrap"}
  t6:usize = int.cast(d6) {"mode":"wrap"}
  cpu6:u64 = call(r6,p6) {"function":"read_u64"}
  ack6:u64 = call(r6,q6) {"function":"read_u64"}
  current_root6:u64 = call(r6,s6) {"function":"read_u64"}
  completed6:u64 = call(r6,t6) {"function":"read_u64"}
  maxcpu6:u64 = const() {"value":64}
  cpuok6:bool = compare.lt(cpu6,maxcpu6)
  branch cpuok6 membership(r6,root6,epoch6,target6,count6,i6,seen6,cpu6,ack6,current_root6,completed6) bad_row()
block membership(r7:readbuf,root7:u64,epoch7:u64,target7:u64,count7:u64,i7:u64,seen7:u64,cpu7:u64,ack7:u64,current_root7:u64,completed7:u64)
  one7:u64 = const() {"value":1}
  zero7:u64 = const() {"value":0}
  bit7:u64 = int.shl.checked(one7,cpu7)
  eligible7:u64 = bit.and(bit7,target7)
  prior7:u64 = bit.and(bit7,seen7)
  in_target7:bool = compare.ne(eligible7,zero7)
  unseen7:bool = compare.eq(prior7,zero7)
  eligible:bool = bool.and(in_target7,unseen7)
  branch eligible ack_check(r7,root7,epoch7,target7,count7,i7,seen7,bit7,ack7,current_root7,completed7) bad_row()
block bad_row()
  e3:u32 = const() {"value":3}
  ret(e3)
block ack_check(r8:readbuf,root8:u64,epoch8:u64,target8:u64,count8:u64,i8:u64,seen8:u64,bit8:u64,ack8:u64,current_root8:u64,completed8:u64)
  expected_completion8:u64 = const() {"value":3}
  epochok8:bool = compare.eq(ack8,epoch8)
  rootok8:bool = compare.eq(current_root8,root8)
  completedok8:bool = compare.eq(completed8,expected_completion8)
  both8:bool = bool.and(epochok8,rootok8)
  valid8:bool = bool.and(both8,completedok8)
  branch valid8 next(r8,root8,epoch8,target8,count8,i8,seen8,bit8) bad_ack()
block bad_ack()
  e4:u32 = const() {"value":4}
  ret(e4)
block next(r9:readbuf,root9:u64,epoch9:u64,target9:u64,count9:u64,i9:u64,seen9:u64,bit9:u64)
  one9:u64 = const() {"value":1}
  j9:u64 = int.add.wrap(i9,one9)
  new_seen9:u64 = bit.or(seen9,bit9)
  jump scan(r9,root9,epoch9,target9,count9,j9,new_seen9)
block complete_scan(seen10:u64,target10:u64)
  all10:bool = compare.eq(seen10,target10)
  branch all10 accepted() bad_missing()
block bad_missing()
  e5:u32 = const() {"value":5}
  ret(e5)
block accepted()
  e0:u32 = const() {"value":0}
  ret(e0)
end
fn read_u64(data:readbuf,base:usize) -> (u64) effects(read,trap) entry(start)
block start(data:readbuf,base:usize)
  zero:u64 = const() {"value":0}
  jump loop(data,base,zero,zero)
block loop(d1:readbuf,b1:usize,i1:u64,acc1:u64)
  eight:u64 = const() {"value":8}
  more:bool = compare.lt(i1,eight)
  branch more byte(d1,b1,i1,acc1) done(acc1)
block byte(d2:readbuf,b2:usize,i2:u64,acc2:u64)
  index:usize = int.cast(i2) {"mode":"wrap"}
  where:usize = int.add.wrap(b2,index)
  octet:u8 = buffer.load(d2,where)
  wide:u64 = int.cast(octet) {"mode":"wrap"}
  shiftby:u64 = const() {"value":8}
  shift:u64 = int.mul.wrap(i2,shiftby)
  part:u64 = int.shl.checked(wide,shift)
  result:u64 = bit.or(acc2,part)
  one:u64 = const() {"value":1}
  following:u64 = int.add.wrap(i2,one)
  jump loop(d2,b2,following,result)
block done(result:u64)
  ret(result)
end
