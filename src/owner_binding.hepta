block inspect(ob_bmi_state:mutbuf,ob_bmi_pages:u64,ob_bmi_reserved:u64,ob_bmi_expected:u64,ob_bmi_limit:u64,ob_bmi_index:u64,ob_bmi_count:u64)
  ob_bmi_three:u64 = const() {"value":3}
  ob_bmi_seven:u64 = const() {"value":7}
  ob_bmi_header:u64 = const() {"value":64}
  ob_bmi_one:u64 = const() {"value":1}
  ob_bmi_zero:u64 = const() {"value":0}
  ob_bmi_byte_index:u64 = int.shr.checked(ob_bmi_index,ob_bmi_three)
