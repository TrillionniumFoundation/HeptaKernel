  ob_bmi_usize:usize = int.cast(ob_bmi_offset) {"mode":"wrap"}
  ob_bmi_byte:u8 = buffer.load(ob_bmi_state,ob_bmi_usize)
  ob_bmi_word:u64 = int.cast(ob_bmi_byte) {"mode":"wrap"}
  ob_bmi_position:u64 = bit.and(ob_bmi_index,ob_bmi_seven)
  ob_bmi_mask:u64 = int.shl.checked(ob_bmi_one,ob_bmi_position)
  ob_bmi_present:u64 = bit.and(ob_bmi_word,ob_bmi_mask)
  ob_bmi_set:bool = compare.ne(ob_bmi_present,ob_bmi_zero)
  ob_bmi_reserved_bit:bool = compare.lt(ob_bmi_index,ob_bmi_reserved)
  ob_bmi_active:bool = compare.lt(ob_bmi_index,ob_bmi_pages)
  ob_bmi_not_set:bool = bool.not(ob_bmi_set)
  ob_bmi_not_active:bool = bool.not(ob_bmi_active)
  ob_bmi_bad_prefix:bool = bool.and(ob_bmi_reserved_bit,ob_bmi_not_set)
  ob_bmi_bad_tail:bool = bool.and(ob_bmi_not_active,ob_bmi_set)
  ob_bmi_bad:bool = bool.or(ob_bmi_bad_prefix,ob_bmi_bad_tail)
  branch ob_bmi_bad invalid() count_bit(ob_bmi_state,ob_bmi_pages,ob_bmi_reserved,ob_bmi_expected,ob_bmi_limit,ob_bmi_index,ob_bmi_count,ob_bmi_active,ob_bmi_reserved_bit,ob_bmi_not_set)
block count_bit(ob_bmc_state:mutbuf,ob_bmc_pages:u64,ob_bmc_reserved:u64,ob_bmc_expected:u64,ob_bmc_limit:u64,ob_bmc_index:u64,ob_bmc_count:u64,ob_bmc_active:bool,ob_bmc_reserved_bit:bool,ob_bmc_not_set:bool)
  ob_bmc_dynamic:bool = bool.not(ob_bmc_reserved_bit)
  ob_bmc_v0:bool = bool.and(ob_bmc_active,ob_bmc_dynamic)
  ob_bmc_is_free:bool = bool.and(ob_bmc_v0,ob_bmc_not_set)
  ob_bmc_one:u64 = const() {"value":1}
  ob_bmc_zero:u64 = const() {"value":0}
  ob_bmc_delta:u64 = select(ob_bmc_is_free,ob_bmc_one,ob_bmc_zero)
  ob_bmc_next_count:u64 = int.add.wrap(ob_bmc_count,ob_bmc_delta)
  ob_bmc_next_index:u64 = int.add.wrap(ob_bmc_index,ob_bmc_one)
  jump scan(ob_bmc_state,ob_bmc_pages,ob_bmc_reserved,ob_bmc_expected,ob_bmc_limit,ob_bmc_next_index,ob_bmc_next_count)
block finish(ob_bmf_expected:u64,ob_bmf_actual:u64)
  ob_bmf_ok:bool = compare.eq(ob_bmf_expected,ob_bmf_actual)
  ret(ob_bmf_ok)
block invalid()
  ob_bmf_reject:bool = const() {"value":false}
  ret(ob_bmf_reject)
end
