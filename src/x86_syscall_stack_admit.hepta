hia-asm.v1 hepta.hia.program.v8 selfhost_elf
exports(syscall_stack_admit)
fn syscall_stack_admit(user_rsp:u64,kernel_rsp:u64,tss_rsp0:u64) -> (u32) effects(trap) entry(start)
block start(user_rsp:u64,kernel_rsp:u64,tss_rsp0:u64)
  user_lower:u64 = const() {"value":4096}
  user_upper:u64 = const() {"value":140737488355328}
  user_min:bool = compare.ge(user_rsp,user_lower)
  user_max:bool = compare.lt(user_rsp,user_upper)
  user_ok:bool = bool.and(user_min,user_max)
  branch user_ok kernel(kernel_rsp,tss_rsp0) bad_user()
block bad_user()
  bad_user_code:u32 = const() {"value":1}
  ret(bad_user_code)
block kernel(kernel_rsp1:u64,tss_rsp1:u64)
  kernel_lower:u64 = const() {"value":4096}
  kernel_upper:u64 = const() {"value":4194304}
  mask:u64 = const() {"value":15}
  zero:u64 = const() {"value":0}
  kern_min:bool = compare.ge(kernel_rsp1,kernel_lower)
  kern_max:bool = compare.lt(kernel_rsp1,kernel_upper)
  align_bits:u64 = bit.and(kernel_rsp1,mask)
  aligned:bool = compare.eq(align_bits,zero)
  region:bool = bool.and(kern_min,kern_max)
  valid:bool = bool.and(region,aligned)
  branch valid tss(kernel_rsp1,tss_rsp1) bad_kernel()
block bad_kernel()
  bad_kernel_code:u32 = const() {"value":2}
  ret(bad_kernel_code)
block tss(kernel_rsp2:u64,tss_rsp2:u64)
  match:bool = compare.eq(kernel_rsp2,tss_rsp2)
  branch match good() bad_tss()
block bad_tss()
  bad_tss_code:u32 = const() {"value":3}
  ret(bad_tss_code)
block good()
  accepted_code:u32 = const() {"value":0}
  ret(accepted_code)
end
