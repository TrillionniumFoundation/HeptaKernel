  valid:bool = compare.ne(encoded,refused_code)
  valid_r:bool = compare.ne(encoded_r,refused_code)
  both:bool = bool.and(valid,valid_r)
  branch both commit(c_dst,encoded,encoded_r) bad_input()
block commit(w_dst:mutbuf,w_dev:u64,w_rdev:u64)
  offset:usize = const() {"value":0}
  offset_r:usize = const() {"value":40}
  first:u32 = call(w_dst,offset,w_dev) {"function":"store_stat_dev_word"}
  second:u32 = call(w_dst,offset_r,w_rdev) {"function":"store_stat_dev_word"}
  status:u32 = bit.or(first,second)
  ret(status)
block bad_length()
  bad_size:u32 = const() {"value":1}
  ret(bad_size)
block bad_input()
  bad_dev:u32 = const() {"value":2}
  ret(bad_dev)
end
fn store_stat_dev_word(dst:mutbuf,base:usize,word:u64) -> (u32) effects(write,trap) entry(start)
