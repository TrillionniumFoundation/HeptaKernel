fn read64(image:readbuf,offset:usize) -> (u64) effects(read,trap) entry(start)
block start(image:readbuf,offset:usize)
  lo:u64 = call(image,offset) {"function":"read32"}
  step:usize = const() {"value":4}
  next:usize = int.add.wrap(offset,step)
