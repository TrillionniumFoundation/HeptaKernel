  rg_valid:bool = bool.and(rg_nonempty,rg_no_overflow)
  branch rg_valid overlap(rg_in_wire,rg_in_reply,rg_in_start,rg_in_end,rg_in_usable,rg_in_count,rg_in_index,rg_in_hit,rg_span_base,rg_span_length) invalid(rg_in_reply)
