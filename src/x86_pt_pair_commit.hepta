fn leaf_valid(entry: u64,cap:u64,width:u64) -> (u32) effects() entry(start)
block start(entry:u64,cap:u64,width:u64)
  onev:u64 = const() {"value":1}
  zerov:u64 = const() {"value":0}
  twov:u64 = const() {"value":2}
  nxmask:u64 = const() {"value":9223372036854775808}
  globalmask:u64 = const() {"value":256}
  nxe_cap:u64 = const() {"value":256}
  pge_cap:u64 = const() {"value":512}
  physmask:u64 = const() {"value":4503599627366400}
  reservedmask:u64 = const() {"value":9218868437227405312}
  presentbits:u64 = bit.and(entry,onev)
  present:bool = compare.eq(presentbits,onev)
  forbid:u64 = bit.and(entry,reservedmask)
  reservedok:bool = compare.eq(forbid,zerov)
  phys:u64 = bit.and(entry,physmask)
  hasphys:bool = compare.ne(phys,zerov)
  above:u64 = int.shr.checked(phys,width)
  widthok:bool = compare.eq(above,zerov)
  nxbit:u64 = bit.and(entry,nxmask)
  is_nx:bool = compare.ne(nxbit,zerov)
  writable:u64 = bit.and(entry,twov)
  is_rw:bool = compare.ne(writable,zerov)
  executable:bool = bool.not(is_nx)
  wx:bool = bool.and(is_rw,executable)
  wxok:bool = bool.not(wx)
  c_nxe:u64 = bit.and(cap,nxe_cap)
  nxe:bool = compare.ne(c_nxe,zerov)
  c_pge:u64 = bit.and(cap,pge_cap)
  pge:bool = compare.ne(c_pge,zerov)
  is_global_bit:u64 = bit.and(entry,globalmask)
  is_global:bool = compare.ne(is_global_bit,zerov)
  missing_nxe:bool = bool.not(nxe)
  missing_pge:bool = bool.not(pge)
  bad_nx:bool = bool.and(is_nx,missing_nxe)
  bad_global:bool = bool.and(is_global,missing_pge)
  caperror:bool = bool.or(bad_nx,bad_global)
  capok:bool = bool.not(caperror)
  a_ok:bool = bool.and(present,reservedok)
  b_ok:bool = bool.and(hasphys,widthok)
  c_ok:bool = bool.and(wxok,capok)
  d_ok:bool = bool.and(a_ok,b_ok)
  e_ok:bool = bool.and(d_ok,c_ok)
  branch e_ok valid() invalid()
block valid()
  success:u32 = const() {"value":1}
  ret(success)
block invalid()
  failure:u32 = const() {"value":0}
  ret(failure)
end
fn read64_request(data:readbuf,base:usize) -> (u64) effects(read,trap) entry(start)
