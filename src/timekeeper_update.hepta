block check_generation(cg_req:readbuf,cg_out:mutbuf,cg_mem:mutbuf,cg_generation:u64)
  cg_max:u64 = const() {"value":18446744073709551615}
  cg_room:bool = compare.lt(cg_generation,cg_max)
