  slot11:usize = const() {"value":4056}
  stored11:u32 = call(p4,slot11,w_nine) {"function":"write_word"}
  slot12:usize = const() {"value":4064}
  stored12:u32 = call(p4,slot12,entry4) {"function":"write_word"}
  slot13:usize = const() {"value":4072}
  stored13:u32 = call(p4,slot13,w_zero) {"function":"write_word"}
  slot14:usize = const() {"value":4080}
  stored14:u32 = call(p4,slot14,w_zero) {"function":"write_word"}
  slot15:usize = const() {"value":4088}
  stored15:u32 = call(p4,slot15,w_zero) {"function":"write_word"}
  user_sp:u64 = int.add.wrap(base4,w_tail)
  receiptoff0:usize = const() {"value":0}
  receiptoff8:usize = const() {"value":8}
  receipta:u32 = call(m4,receiptoff0,user_sp) {"function":"write_word"}
  receiptb:u32 = call(m4,receiptoff8,w_written) {"function":"write_word"}
  success:u32 = const() {"value":0}
