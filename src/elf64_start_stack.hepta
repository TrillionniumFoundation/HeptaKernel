fn f0(request:readbuf,page:mutbuf,receipt:mutbuf) -> (u32) effects(read,write,trap) entry(start)
block start(request:readbuf,page:mutbuf,receipt:mutbuf)
  a:usize = buffer.len(request)
  b:usize = const() {"value":40}
  ok:bool = compare.eq(a,b)
  branch ok sizecheck(request,page,receipt) bad_request()
block bad_request()
  error_request:u32 = const() {"value":1}
  ret(error_request)
block sizecheck(r:readbuf,p:mutbuf,m:mutbuf)
  p_size:usize = buffer.len(p)
  exact_page:usize = const() {"value":4096}
  page_ok:bool = compare.eq(p_size,exact_page)
  m_size:usize = buffer.len(m)
  exact_receipt:usize = const() {"value":16}
  receipt_ok:bool = compare.eq(m_size,exact_receipt)
  sizes_ok:bool = bool.and(page_ok,receipt_ok)
  branch sizes_ok decode(r,p,m) bad_size()
block bad_size()
  error_size:u32 = const() {"value":2}
  ret(error_size)
block decode(r2:readbuf,p2:mutbuf,m2:mutbuf)
  off0:usize = const() {"value":0}
  value0:u64 = call(r2,off0) {"function":"read_word"}
  off1:usize = const() {"value":8}
  value1:u64 = call(r2,off1) {"function":"read_word"}
  off2:usize = const() {"value":16}
  value2:u64 = call(r2,off2) {"function":"read_word"}
  off3:usize = const() {"value":24}
  value3:u64 = call(r2,off3) {"function":"read_word"}
  off4:usize = const() {"value":32}
  value4:u64 = call(r2,off4) {"function":"read_word"}
  jump admission(p2,m2,value0,value1,value2,value3,value4)
block admission(p3:mutbuf,m3:mutbuf,base:u64,entry:u64,phdr:u64,phent:u64,phnum:u64)
  k_zero:u64 = const() {"value":0}
  k_one:u64 = const() {"value":1}
  k_max_num:u64 = const() {"value":128}
  k_minimum:u64 = const() {"value":4096}
  k_max_base:u64 = const() {"value":140737488351232}
  k_max_address:u64 = const() {"value":140737488355327}
  k_max_phdr:u64 = const() {"value":140737488347136}
  k_mask:u64 = const() {"value":4095}
  k_phentsize:u64 = const() {"value":56}
  base_present:bool = compare.gt(base,k_zero)
  base_bounded:bool = compare.le(base,k_max_base)
  misaligned:u64 = bit.and(base,k_mask)
  aligned:bool = compare.eq(misaligned,k_zero)
  entry_min:bool = compare.ge(entry,k_minimum)
  entry_max:bool = compare.le(entry,k_max_address)
  phdr_min:bool = compare.ge(phdr,k_minimum)
  phdr_max:bool = compare.le(phdr,k_max_phdr)
  ent_ok:bool = compare.eq(phent,k_phentsize)
  count_min:bool = compare.ge(phnum,k_one)
  count_max:bool = compare.le(phnum,k_max_num)
  g1:bool = bool.and(base_present,base_bounded)
  g2:bool = bool.and(g1,aligned)
  g3:bool = bool.and(g2,entry_min)
  g4:bool = bool.and(g3,entry_max)
  g5:bool = bool.and(g4,phdr_min)
  g6:bool = bool.and(g5,phdr_max)
  g7:bool = bool.and(g6,ent_ok)
  g8:bool = bool.and(g7,count_min)
  g9:bool = bool.and(g8,count_max)
  branch g9 separate_stack(p3,m3,base,entry,phdr,phnum) bad_values()
block separate_stack(stack_page:mutbuf,stack_receipt:mutbuf,stack_base:u64,stack_entry:u64,stack_phdr:u64,stack_phnum:u64)
  sep_pagebytes:u64 = const() {"value":4096}
  sep_entrybytes:u64 = const() {"value":56}
  sep_stackend:u64 = int.add.wrap(stack_base,sep_pagebytes)
  sep_phbytes:u64 = int.mul.wrap(stack_phnum,sep_entrybytes)
  sep_phend:u64 = int.add.wrap(stack_phdr,sep_phbytes)
  sep_entry_before:bool = compare.lt(stack_entry,stack_base)
  sep_entry_after:bool = compare.ge(stack_entry,sep_stackend)
  sep_entry_disjoint:bool = bool.or(sep_entry_before,sep_entry_after)
  sep_ph_before:bool = compare.le(sep_phend,stack_base)
  sep_ph_after:bool = compare.ge(stack_phdr,sep_stackend)
  sep_ph_disjoint:bool = bool.or(sep_ph_before,sep_ph_after)
  sep_safe:bool = bool.and(sep_entry_disjoint,sep_ph_disjoint)
  branch sep_safe store_stack(stack_page,stack_receipt,stack_base,stack_entry,stack_phdr,stack_phnum) bad_values()
block bad_values()
  error_values:u32 = const() {"value":3}
  ret(error_values)
