  w_six:u64 = const() {"value":6}
  w_nine:u64 = const() {"value":9}
  w_fiftysix:u64 = const() {"value":56}
  w_pagesize:u64 = const() {"value":4096}
  w_tail:u64 = const() {"value":3968}
  w_written:u64 = const() {"value":128}
  slot0:usize = const() {"value":3968}
  stored0:u32 = call(p4,slot0,w_zero) {"function":"write_word"}
  slot1:usize = const() {"value":3976}
  stored1:u32 = call(p4,slot1,w_zero) {"function":"write_word"}
  slot2:usize = const() {"value":3984}
  stored2:u32 = call(p4,slot2,w_zero) {"function":"write_word"}
  slot3:usize = const() {"value":3992}
  stored3:u32 = call(p4,slot3,w_three) {"function":"write_word"}
  slot4:usize = const() {"value":4000}
  stored4:u32 = call(p4,slot4,phdr4) {"function":"write_word"}
  slot5:usize = const() {"value":4008}
  stored5:u32 = call(p4,slot5,w_four) {"function":"write_word"}
  slot6:usize = const() {"value":4016}
  stored6:u32 = call(p4,slot6,w_fiftysix) {"function":"write_word"}
  slot7:usize = const() {"value":4024}
  stored7:u32 = call(p4,slot7,w_five) {"function":"write_word"}
  slot8:usize = const() {"value":4032}
  stored8:u32 = call(p4,slot8,phnum4) {"function":"write_word"}
  slot9:usize = const() {"value":4040}
