hia-asm.v1 hepta.hia.program.kernel-tlb.v1 selfhost_elf
exports(f0)
fn f0(slot:u64,expected:u64,count:u64,task:u64,desired:u64) -> (u64) effects(privilege,atomic,read,write,trap) entry(start)
block start(slot:u64,expected:u64,count:u64,task:u64,desired:u64)
  zero:u64 = const() {"value":0}
  one:u64 = const() {"value":1}
  seven:u64 = const() {"value":7}
  limit:u64 = const() {"value":140737488355328}
  width:u64 = const() {"value":32}
  align:u64 = bit.and(slot,seven)
  aligned:bool = compare.eq(align,zero)
  nonnull:bool = compare.ne(slot,zero)
  canonical:bool = compare.lt(slot,limit)
  nonempty:bool = compare.lt(zero,count)
  bounded:bool = compare.le(count,width)
  taskok:bool = compare.lt(task,count)
  desireok:bool = compare.le(desired,one)
  p:bool = bool.and(aligned,nonnull)
  q:bool = bool.and(canonical,nonempty)
  r:bool = bool.and(bounded,taskok)
  s:bool = bool.and(p,q)
  t:bool = bool.and(r,desireok)
  valid:bool = bool.and(s,t)
  branch valid decode(slot,expected,count,task,desired) invalid()
block decode(ptr:u64,old:u64,n:u64,id:u64,want:u64)
  lowmask:u64 = const() {"value":4294967295}
  bits:u64 = bit.and(old,lowmask)
  upper:u64 = int.shr.checked(bits,n)
  z:u64 = const() {"value":0}
  clean:bool = compare.eq(upper,z)
  shift:u64 = const() {"value":32}
  generation:u64 = int.shr.checked(old,shift)
  room:bool = compare.lt(generation,lowmask)
  admissible:bool = bool.and(clean,room)
  branch admissible update(ptr,old,id,want,bits,generation) invalid()
block update(address:u64,prior:u64,tid:u64,target:u64,mask:u64,gen:u64)
  unit:u64 = const() {"value":1}
  bit:u64 = int.shl.checked(unit,tid)
  selected:u64 = bit.and(mask,bit)
  requested:u64 = int.shl.checked(target,tid)
  change:bool = compare.ne(selected,requested)
  branch change exchange(address,prior,mask,bit,gen) verifyduplicate(address,prior)
block exchange(dest:u64,previous:u64,bitmap:u64,marker:u64,g:u64)
  increment:u64 = const() {"value":1}
  nextgen:u64 = int.add.wrap(g,increment)
  nshift:u64 = const() {"value":32}
  high:u64 = int.shl.checked(nextgen,nshift)
  toggled:u64 = bit.xor(bitmap,marker)
  nextstate:u64 = bit.or(high,toggled)
  observed:u64 = x86.atomic.cmpxchg64(dest,previous,nextstate)
  matched:bool = compare.eq(observed,previous)
  branch matched success() stale()
block success()
  _ = x86.fence.mfence()
  ok:u64 = const() {"value":0}
  ret(ok)
block invalid()
  bad:u64 = const() {"value":6}
  ret(bad)
block verifyduplicate(dupaddr:u64,dupold:u64)
  duplive:u64 = x86.atomic.cmpxchg64(dupaddr,dupold,dupold)
  dupmatched:bool = compare.eq(duplive,dupold)
  branch dupmatched duplicate() stale()
block duplicate()
  repeated:u64 = const() {"value":7}
  ret(repeated)
block stale()
  conflict:u64 = const() {"value":9}
  ret(conflict)
end
