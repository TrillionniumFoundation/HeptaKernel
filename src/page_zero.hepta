hia-asm.v1 hepta.hia.program.v8 selfhost_elf
fn page_zero(request:readbuf,reply:mutbuf,page:mutbuf) -> (u32) effects(write,trap) entry(start)
block start(request:readbuf,reply:mutbuf,page:mutbuf)
  request_len:usize = buffer.len(request)
  required_request:usize = const() {"value":0}
  request_valid:bool = compare.eq(request_len,required_request)
  branch request_valid check_reply(reply,page) invalid_request()
block invalid_request()
  code:u32 = const() {"value":1}
  ret(code)
block check_reply(reply_cap:mutbuf,page_cap:mutbuf)
  reply_len:usize = buffer.len(reply_cap)
  required_reply:usize = const() {"value":16}
  reply_valid:bool = compare.eq(reply_len,required_reply)
  branch reply_valid check_page(reply_cap,page_cap) invalid_reply()
block invalid_reply()
  code:u32 = const() {"value":2}
  ret(code)
block check_page(checked_reply:mutbuf,checked_page:mutbuf)
  page_len:usize = buffer.len(checked_page)
  required_page:usize = const() {"value":4096}
  page_valid:bool = compare.eq(page_len,required_page)
  branch page_valid zero_page(checked_reply,checked_page) invalid_page()
block invalid_page()
  code:u32 = const() {"value":3}
  ret(code)
block zero_page(output:mutbuf,frame:mutbuf)
  beginning:usize = const() {"value":0}
  frame_bytes:usize = const() {"value":4096}
  reply_bytes:usize = const() {"value":16}
  zero:u8 = const() {"value":0}
  _ = buffer.fill_range(frame,beginning,frame_bytes,zero)
  _ = buffer.fill_range(output,beginning,reply_bytes,zero)
  length_high_offset:usize = const() {"value":9}
  length_high:u8 = const() {"value":16}
  _ = buffer.store(output,length_high_offset,length_high)
  success:u32 = const() {"value":0}
  ret(success)
end
