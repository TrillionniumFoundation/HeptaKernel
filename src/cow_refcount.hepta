  branch cf_scan_more inspect(cf_scan_req,cf_scan_rep,cf_scan_table,cf_scan_slot,cf_scan_action,cf_scan_expected,cf_scan_index) slot_gate(cf_scan_rep,cf_scan_table,cf_scan_slot,cf_scan_action,cf_scan_expected)
