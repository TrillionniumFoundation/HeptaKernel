  cf_is_detach:bool = compare.eq(cf_action_code,cf_action_detach)
  cf_is_release:bool = compare.eq(cf_action_code,cf_action_release)
  cf_any_first:bool = bool.or(cf_is_share,cf_is_detach)
  cf_any_action:bool = bool.or(cf_any_first,cf_is_release)
  branch cf_any_action stale_gate(cf_action_rep,cf_action_table,cf_action_slot,cf_action_expected,cf_is_share,cf_is_detach) bad_action()
