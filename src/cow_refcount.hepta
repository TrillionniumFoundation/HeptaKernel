  cf_reserved_first:u64 = const() {"value":4}
  jump reserved(cf_wire,cf_output,cf_table,cf_slot,cf_action,cf_expected,cf_reserved_first)
block reserved(cf_scan_req:readbuf,cf_scan_rep:mutbuf,cf_scan_table:mutbuf,cf_scan_slot:u64,cf_scan_action:u8,cf_scan_expected:u8,cf_scan_index:u64)
  cf_scan_end:u64 = const() {"value":16}
