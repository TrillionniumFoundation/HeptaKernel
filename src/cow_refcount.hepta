block decode(cf_wire:readbuf,cf_output:mutbuf,cf_table:mutbuf)
  cf_at0:usize = const() {"value":0}
  cf_at1:usize = const() {"value":1}
  cf_at2:usize = const() {"value":2}
  cf_at3:usize = const() {"value":3}
  cf_lo:u8 = buffer.load(cf_wire,cf_at0)
  cf_hi:u8 = buffer.load(cf_wire,cf_at1)
  cf_action:u8 = buffer.load(cf_wire,cf_at2)
  cf_expected:u8 = buffer.load(cf_wire,cf_at3)
  cf_lo64:u64 = int.cast(cf_lo) {"mode":"wrap"}
  cf_hi64:u64 = int.cast(cf_hi) {"mode":"wrap"}
