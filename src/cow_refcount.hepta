block stale_gate(cf_stale_rep:mutbuf,cf_stale_table:mutbuf,cf_stale_slot:u64,cf_stale_expected:u8,cf_stale_share:bool,cf_stale_detach:bool)
  cf_stale_at:usize = int.cast(cf_stale_slot) {"mode":"wrap"}
  cf_stale_seen:u8 = buffer.load(cf_stale_table,cf_stale_at)
  cf_stale_match:bool = compare.eq(cf_stale_seen,cf_stale_expected)
