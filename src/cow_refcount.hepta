  branch cf_transition_share share(cf_transition_rep,cf_transition_table,cf_transition_at,cf_transition_old) other(cf_transition_rep,cf_transition_table,cf_transition_at,cf_transition_old,cf_transition_detach)
block share(cf_share_rep:mutbuf,cf_share_table:mutbuf,cf_share_at:usize,cf_share_old:u8)
  cf_share_min:u8 = const() {"value":1}
  cf_share_max:u8 = const() {"value":254}
  cf_share_above:bool = compare.ge(cf_share_old,cf_share_min)
  cf_share_below:bool = compare.le(cf_share_old,cf_share_max)
  cf_share_ok:bool = bool.and(cf_share_above,cf_share_below)
