  fi_remaining:u64 = int.sub.wrap(fi_end,fi_candidate)
  fi_enough:bool = compare.le(fi_pages,fi_remaining)
  fi_usable:bool = bool.and(fi_inside,fi_enough)
  branch fi_usable return_fit(fi_reply,fi_candidate) next_fit(fi_wire,fi_reply,fi_align,fi_pages,fi_count,fi_i)
