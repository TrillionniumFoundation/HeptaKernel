block inspect_fit(fi_wire:readbuf,fi_reply:mutbuf,fi_align:u64,fi_pages:u64,fi_count:u64,fi_i:u64)
  fi_width:u64 = const() {"value":24}
  fi_prefix:u64 = const() {"value":32}
  fi_eight:u64 = const() {"value":8}
  fi_sixteen:u64 = const() {"value":16}
  fi_shift:u64 = const() {"value":12}
  fi_one:u64 = const() {"value":1}
  fi_off:u64 = int.mul.wrap(fi_i,fi_width)
  fi_base_off:u64 = int.add.wrap(fi_off,fi_prefix)
  fi_pages_off:u64 = int.add.wrap(fi_base_off,fi_eight)
  fi_reserved_off:u64 = int.add.wrap(fi_base_off,fi_sixteen)
  fi_base_at:usize = int.cast(fi_base_off) {"mode":"wrap"}
  fi_pages_at:usize = int.cast(fi_pages_off) {"mode":"wrap"}
  fi_reserved_at:usize = int.cast(fi_reserved_off) {"mode":"wrap"}
  fi_base:u64 = call(fi_wire,fi_base_at) {"function":"read_u64"}
  fi_size:u64 = call(fi_wire,fi_pages_at) {"function":"read_u64"}
  fi_reserved:u64 = call(fi_wire,fi_reserved_at) {"function":"read_u64"}
  fi_base_page:u64 = int.shr.checked(fi_base,fi_shift)
  fi_usable_page:u64 = int.add.wrap(fi_base_page,fi_reserved)
