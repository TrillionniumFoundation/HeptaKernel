block check_destination(valid_source:readbuf,valid_receipt:mutbuf,destination:mutbuf)
  destination_len:usize = buffer.len(destination)
  page_bytes:usize = const() {"value":4096}
  destination_valid:bool = compare.eq(destination_len,page_bytes)
  branch destination_valid perform_copy(valid_source,valid_receipt,destination) invalid_destination()
block invalid_destination()
  destination_error:u32 = const() {"value":3}
  ret(destination_error)
block perform_copy(valid_source:readbuf,valid_receipt:mutbuf,valid_destination:mutbuf)
  zero_offset:usize = const() {"value":0}
  page_bytes:usize = const() {"value":4096}
  receipt_bytes:usize = const() {"value":16}
  zero:u8 = const() {"value":0}
  _ = buffer.copy_range(valid_destination,valid_source,zero_offset,zero_offset,page_bytes)
  _ = buffer.fill_range(valid_receipt,zero_offset,receipt_bytes,zero)
  high_offset:usize = const() {"value":9}
  high_byte:u8 = const() {"value":16}
  _ = buffer.store(valid_receipt,high_offset,high_byte)
