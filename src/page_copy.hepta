fn page_copy(source:readbuf,receipt:mutbuf,destination:mutbuf) -> (u32) effects(read,write,trap) entry(start)
block start(source:readbuf,receipt:mutbuf,destination:mutbuf)
  source_len:usize = buffer.len(source)
  page_bytes:usize = const() {"value":4096}
  source_valid:bool = compare.eq(source_len,page_bytes)
  branch source_valid check_receipt(source,receipt,destination) invalid_source()
block invalid_source()
  source_error:u32 = const() {"value":1}
  ret(source_error)
block check_receipt(valid_source:readbuf,receipt:mutbuf,destination:mutbuf)
  receipt_len:usize = buffer.len(receipt)
  receipt_bytes:usize = const() {"value":16}
  receipt_valid:bool = compare.eq(receipt_len,receipt_bytes)
