fn f3(table:u64,oldpage:u64,newpage:u64,expected:u64) -> (u64) effects(privilege,atomic,read,write,trap) entry(start)
block start(table:u64,oldpage:u64,newpage:u64,expected:u64)
  mask:u64 = const() {"value":4095}
