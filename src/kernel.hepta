  free_count:u64 = call(inspect_state,free_offset) {"function":"read_state_u64"}
  page_shift:u64 = const() {"value":12}
  delta:u64 = int.sub.wrap(inspect_address,base)
  page_index:u64 = int.shr.checked(delta,page_shift)
  at_or_above:bool = compare.ge(inspect_address,base)
  below_end:bool = compare.lt(page_index,pages)
  inside:bool = bool.and(at_or_above,below_end)
  branch inside check_reserved(inspect_reply,inspect_state,page_index,pages,reserved,free_count) invalid_arguments(inspect_reply)
block check_reserved(reserved_reply:mutbuf,reserved_state:mutbuf,index:u64,page_count:u64,reserved_count:u64,available:u64)
  is_reserved:bool = compare.lt(index,reserved_count)
  branch is_reserved reserved_error(reserved_reply) check_allocated(reserved_reply,reserved_state,index,page_count,reserved_count,available)
