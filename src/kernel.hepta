fn free_page(reply:mutbuf,state:mutbuf,address:u64,b:u64,c:u64) -> (u32) effects(read,write,trap) entry(start)
block start(reply:mutbuf,state:mutbuf,address:u64,b:u64,c:u64)
  zero:u64 = const() {"value":0}
  page_mask:u64 = const() {"value":4095}
  unused:u64 = bit.or(b,c)
