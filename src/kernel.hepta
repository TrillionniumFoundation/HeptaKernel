  invalid_bits:u64 = bit.or(unused,low_bits)
  valid_arguments:bool = compare.eq(invalid_bits,zero)
  branch valid_arguments check_state(reply,state,address) invalid_arguments(reply)
block invalid_arguments(argument_reply:mutbuf)
  argument_status:u32 = const() {"value":6}
  argument_value:u64 = const() {"value":0}
  argument_result:u32 = call(argument_reply,argument_status,argument_value) {"function":"write_reply"}
  ret(argument_result)
block check_state(validation_reply:mutbuf,validation_state:mutbuf,physical_address:u64)
  valid_state:bool = call(validation_state) {"function":"state_valid"}
  branch valid_state inspect(validation_reply,validation_state,physical_address) bad_state(validation_reply)
block bad_state(corrupt_reply:mutbuf)
  corrupt_status:u32 = const() {"value":4}
  corrupt_value:u64 = const() {"value":0}
  corrupt_result:u32 = call(corrupt_reply,corrupt_status,corrupt_value) {"function":"write_reply"}
