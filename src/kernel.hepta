  first:u64 = const() {"value":0}
  initial:u64 = const() {"value":0}
  jump loop(bytes,offset,first,initial)
block loop(input:mutbuf,base_offset:usize,index:u64,accumulator:u64)
  width:u64 = const() {"value":8}
  more:bool = compare.lt(index,width)
  branch more read_byte(input,base_offset,index,accumulator) done(accumulator)
block read_byte(byte_input:mutbuf,word_offset:usize,byte_index:u64,current:u64)
  index_usize:usize = int.cast(byte_index) {"mode":"wrap"}
  address:usize = int.add.wrap(word_offset,index_usize)
  octet:u8 = buffer.load(byte_input,address)
  widened:u64 = int.cast(octet) {"mode":"wrap"}
  eight:u64 = const() {"value":8}
  shift:u64 = int.mul.wrap(byte_index,eight)
  shifted:u64 = int.shl.checked(widened,shift)
  combined:u64 = bit.or(current,shifted)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(byte_index,one)
  jump loop(byte_input,word_offset,next,combined)
block done(value:u64)
  ret(value)
end
fn write_u64(bytes:mutbuf,offset:usize,value:u64) -> (u32) effects(write,trap) entry(start)
block start(bytes:mutbuf,offset:usize,value:u64)
  first:u64 = const() {"value":0}
  jump loop(bytes,offset,value,first)
block loop(output:mutbuf,base_offset:usize,word:u64,index:u64)
  width:u64 = const() {"value":8}
  more:bool = compare.lt(index,width)
  branch more write_byte(output,base_offset,word,index) done()
block write_byte(byte_output:mutbuf,word_offset:usize,source:u64,byte_index:u64)
  index_usize:usize = int.cast(byte_index) {"mode":"wrap"}
  address:usize = int.add.wrap(word_offset,index_usize)
  eight:u64 = const() {"value":8}
  shift:u64 = int.mul.wrap(byte_index,eight)
  shifted:u64 = int.shr.checked(source,shift)
  octet:u8 = int.cast(shifted) {"mode":"wrap"}
  _ = buffer.store(byte_output,address,octet)
  one:u64 = const() {"value":1}
  next:u64 = int.add.wrap(byte_index,one)
  jump loop(byte_output,word_offset,source,next)
block done()
  success:u32 = const() {"value":0}
  ret(success)
end
fn write_reply(reply:mutbuf,status:u32,value:u64) -> (u32) effects(write,trap) entry(start)
block start(reply:mutbuf,status:u32,value:u64)
  status_offset:usize = const() {"value":0}
  value_offset:usize = const() {"value":8}
  wide_status:u64 = int.cast(status) {"mode":"wrap"}
  status_written:u32 = call(reply,status_offset,wide_status) {"function":"write_u64"}
  value_written:u32 = call(reply,value_offset,value) {"function":"write_u64"}
  ret(status)
end
