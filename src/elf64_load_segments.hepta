  zero5:u64 = const() {"value":0}
  pow2:bool = compare.eq(power_bits,zero5)
  low_align:bool = compare.le(al5,one5)
  vmask:u64 = bit.and(va5,mask5)
  omask:u64 = bit.and(off5,mask5)
  modok:bool = compare.eq(vmask,omask)
  align_good:bool = bool.or(low_align,pow2)
  al_congruent:bool = bool.or(low_align,modok)
  both:bool = bool.and(align_good,al_congruent)
  valid:bool = bool.and(both,congruent)
  branch valid entry_cover(im5,p5,n5,total5,entry5,index5,exec5,va5,fs5,x5) bad_geometry()
block entry_cover(im6:readbuf,p6:u64,n6:u64,total6:u64,entry6:u64,index6:u64,exec6:bool,va6:u64,fs6:u64,x6:bool)
  last:u64 = int.add.wrap(va6,fs6)
  above:bool = compare.ge(entry6,va6)
  below:bool = compare.lt(entry6,last)
  inside:bool = bool.and(above,below)
  executable_entry:bool = bool.and(x6,inside)
  found:bool = bool.or(exec6,executable_entry)
  yes:u64 = const() {"value":1}
  true6:bool = compare.eq(yes,yes)
  jump advance(im6,p6,n6,total6,entry6,index6,true6,found)
block advance(im7:readbuf,p7:u64,n7:u64,total7:u64,entry7:u64,index7:u64,load7:bool,exec7:bool)
  one7:u64 = const() {"value":1}
