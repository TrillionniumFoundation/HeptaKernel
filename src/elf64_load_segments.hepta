  a_off:usize = int.cast(at_off) {"mode":"wrap"}
  a_va:usize = int.cast(at_va) {"mode":"wrap"}
  a_file:usize = int.cast(at_file) {"mode":"wrap"}
  a_mem:usize = int.cast(at_mem) {"mode":"wrap"}
  a_align:usize = int.cast(at_align) {"mode":"wrap"}
  flags:u64 = call(im3,a_flags) {"function":"read32"}
