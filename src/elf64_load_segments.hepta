  va:u64 = call(im3,a_va) {"function":"read64"}
  filesz:u64 = call(im3,a_file) {"function":"read64"}
  memsz:u64 = call(im3,a_mem) {"function":"read64"}
  align:u64 = call(im3,a_align) {"function":"read64"}
