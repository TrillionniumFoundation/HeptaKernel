block align_check(im5:readbuf,p5:u64,n5:u64,total5:u64,entry5:u64,index5:u64,exec5:bool,off5:u64,va5:u64,fs5:u64,al5:u64,x5:bool)
  page_mask:u64 = const() {"value":4095}
  one5:u64 = const() {"value":1}
  lowoff:u64 = bit.and(off5,page_mask)
  lowva:u64 = bit.and(va5,page_mask)
