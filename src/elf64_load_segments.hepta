fn read16(image:readbuf,offset:usize) -> (u64) effects(read,trap) entry(start)
block start(image:readbuf,offset:usize)
  octet0:u8 = buffer.load(image,offset)
  one:usize = const() {"value":1}
  offset1:usize = int.add.wrap(offset,one)
  octet1:u8 = buffer.load(image,offset1)
  word0:u64 = int.cast(octet0) {"mode":"wrap"}
  word1:u64 = int.cast(octet1) {"mode":"wrap"}
  shift:u64 = const() {"value":8}
  upper:u64 = int.shl.checked(word1,shift)
  result:u64 = bit.or(upper,word0)
  ret(result)
end
fn read32(image:readbuf,offset:usize) -> (u64) effects(read,trap) entry(start)
block start(image:readbuf,offset:usize)
  lo:u64 = call(image,offset) {"function":"read16"}
