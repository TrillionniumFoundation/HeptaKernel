block load_shape(im4:readbuf,p4:u64,n4:u64,total4:u64,entry4:u64,index4:u64,exec4:bool,off4:u64,va4:u64,fs4:u64,ms4:u64,al4:u64,x4:bool)
  zero4:u64 = const() {"value":0}
